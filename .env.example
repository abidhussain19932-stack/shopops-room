# ---- Switch server (switch-core + Postgres) ----
SWITCH_VERSION=0.31.0
SWITCH_BIND_ADDR=127.0.0.1
DB_NAME=switch
DB_USER=switch_app
DB_PASSWORD=change-me
DB_OWNER_USER=postgres
DB_OWNER_PASSWORD=change-me
AGENT_REGISTRATION_TOKEN=change-me
SECRET_KEYS=k1:change-me-64-hex
GATEWAY_ADMIN_EMAIL=owner@shopops.local
GATEWAY_ADMIN_PASSWORD=change-me
FRONTEND_BASE_URL=http://localhost:8000

# ---- Telegram (one bot backs every agent; Group Privacy must be OFF) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=AMBshopOpsbot
OWNER_TELEGRAM_USERNAME=
# true = anyone in the group may address the agents (demo group for judges)
SHOPOPS_OPEN_ADDRESSING=false

# ---- LLM (Groq, OpenAI-compatible) ----
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# ---- PayPal Sandbox (refunds) ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
